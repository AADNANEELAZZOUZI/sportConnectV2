<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SportConnect Pro - Liste des Activités</title>
    <style>
        :root {
            --primary: #2563eb;
            --primary-dark: #1d4ed8;
            --bg-color: #f8fafc;
            --card-bg: #ffffff;
            --text-color: #1e293b;
            --text-light: #64748b;
            --border-color: #e2e8f0;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            margin: 0;
            padding: 40px 20px;
        }

        .container {
            max-width: 1000px;
            margin: 0 auto;
        }

        header {
            margin-bottom: 30px;
            text-align: center;
        }

        header h1 {
            color: var(--primary);
            margin-bottom: 10px;
        }

        header p {
            color: var(--text-light);
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 20px;
        }

        .card {
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 20px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
        }

        .card h3 {
            margin-top: 0;
            color: var(--text-color);
            font-size: 1.25rem;
        }

        .badge {
            display: inline-block;
            padding: 4px 8px;
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            background-color: #dbeafe;
            color: var(--primary-dark);
            border-radius: 4px;
            margin-bottom: 12px;
        }

        .badge-warning {
            background-color: #fee2e2;
            color: #991b1b;
        }

        .details {
            font-size: 0.9rem;
            color: var(--text-light);
            margin-bottom: 15px;
        }

        .details p {
            margin: 6px 0;
        }

        .price-capacity {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-top: 1px solid var(--border-color);
            padding-top: 12px;
            font-weight: 600;
        }

        .price {
            color: #16a34a;
            font-size: 1.1rem;
        }

        .capacity {
            font-size: 0.85rem;
            color: var(--text-light);
        }

        .empty-state {
            text-align: center;
            padding: 40px;
            color: var(--text-light);
            background: white;
            border-radius: 8px;
            border: 1px solid var(--border-color);
        }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <h1>SportConnect Pro</h1>
            <p>Découvrez la liste de nos activités sportives disponibles</p>
        </header>

        <% if (activities.length === 0) { %>
            <div class="empty-state">
                <p>Aucune activité n'est disponible pour le moment.</p>
            </div>
        <% } else { %>
            <div class="grid">
                <% activities.forEach(activity => { %>
                    <div class="card">
                        <span class="badge"><%= activity.category %></span>
                        <% if (activity.requires_strict_certificate) { %>
                            <span class="badge badge-warning">Certificat Strict</span>
                        <% } %>
                        
                        <h3><%= activity.title %></h3>
                        
                        <div class="details">
                            <p>📅 <strong>Jour :</strong> <%= activity.day_of_week %> (Zone : <%= activity.sub_zone %>)</p>
                            <p>⏰ <strong>Horaires :</strong> <%= activity.start_time %> - <%= activity.end_time %></p>
                        </div>

                        <div class="price-capacity">
                            <span class="price"><%= activity.base_price %> €</span>
                            <span class="capacity">Max : <%= activity.max_capacity %> places</span>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } %>
    </div>
</body>
</html>