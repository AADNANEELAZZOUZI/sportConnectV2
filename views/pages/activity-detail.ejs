<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= activity.title %> - SportConnect Pro</title>
    <style>
        :root {
            --primary: #2563eb;
            --primary-dark: #1d4ed8;
            --bg-color: #f8fafc;
            --card-bg: #ffffff;
            --text-color: #1e293b;
            --text-light: #64748b;
            --border-color: #e2e8f0;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            margin: 0;
            padding: 40px 20px;
        }

        .container {
            max-width: 700px;
            margin: 0 auto;
        }

        .back-link {
            display: inline-block;
            margin-bottom: 20px;
            color: var(--primary);
            text-decoration: none;
            font-weight: 600;
        }

        .back-link:hover {
            text-decoration: underline;
        }

        .card {
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 30px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        }

        .header-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
        }

        h1 {
            margin: 0 0 10px 0;
            color: var(--text-color);
            font-size: 1.8rem;
        }

        .badge {
            display: inline-block;
            padding: 6px 12px;
            font-size: 0.8rem;
            font-weight: 600;
            text-transform: uppercase;
            background-color: #dbeafe;
            color: var(--primary-dark);
            border-radius: 6px;
        }

        .badge-warning {
            background-color: #fee2e2;
            color: #991b1b;
        }

        .info-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin: 25px 0;
            border-top: 1px solid var(--border-color);
            border-bottom: 1px solid var(--border-color);
            padding: 20px 0;
        }

        .info-item p {
            margin: 4px 0;
            color: var(--text-light);
            font-size: 0.9rem;
        }

        .info-item strong {
            color: var(--text-color);
            font-size: 1.05rem;
        }

        .price-section {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 1.2rem;
            font-weight: bold;
        }

        .price {
            color: #16a34a;
            font-size: 1.5rem;
        }
    </style>
</head>
<body>
    <div class="container">
        <a href="/activities" class="back-link">← Retour à la liste des activités</a>
        
        <div class="card">
            <div class="header-row">
                <span class="badge"><%= activity.category %></span>
                <% if (activity.requires_strict_certificate) { %>
                    <span class="badge badge-warning">Certificat Strict Requis</span>
                <% } %>
            </div>

            <h1><%= activity.title %></h1>

            <div class="info-grid">
                <div class="info-item">
                    <p>Jour planifié</p>
                    <strong>Jour n°<%= activity.day_of_week %></strong>
                </div>
                <div class="info-item">
                    <p>Sous-zone</p>
                    <strong>Zone <%= activity.sub_zone %></strong>
                </div>
                <div class="info-item">
                    <p>Horaires</p>
                    <strong><%= activity.start_time %> - <%= activity.end_time %></strong>
                </div>
                <div class="info-item">
                    <p>Capacité maximale</p>
                    <strong><%= activity.max_capacity %> personnes</strong>
                </div>
            </div>

            <div class="price-section">
                <span>Prix de l'activité :</span>
                <span class="price"><%= activity.base_price %> €</span>
            </div>
        </div>
    </div>
</body>
</html>